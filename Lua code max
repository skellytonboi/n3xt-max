    -- Inner accent circle (like the red one in ref image)
    local inner=Instance.new("Frame",main);inner.AnchorPoint=Vector2.new(0.5,0.5);inner.Position=UDim2.fromScale(0.5,0.48);inner.Size=UDim2.fromOffset(SZ-24,SZ-24);inner.BackgroundColor3=innerBG;inner.BorderSizePixel=0;inner.ZIndex=503
    Instance.new("UICorner",inner).CornerRadius=UDim.new(1,0)
    local innerStroke=Instance.new("UIStroke",inner);innerStroke.Color=accentCol;innerStroke.Thickness=1.5;innerStroke.Transparency=0.3

    -- N3XT logo text inside inner circle
    local logoTxt=Instance.new("TextLabel",inner);logoTxt.Size=UDim2.fromScale(1,1);logoTxt.BackgroundTransparency=1;logoTxt.Text="N3XT";logoTxt.Font=Enum.Font.GothamBlack;logoTxt.TextSize=10;logoTxt.TextColor3=accentCol;logoTxt.ZIndex=504

    -- Tier tag at bottom of main circle
    local tierTag=Instance.new("TextLabel",main);tierTag.AnchorPoint=Vector2.new(0.5,1);tierTag.Position=UDim2.new(0.5,0,1,-4);tierTag.Size=UDim2.new(1,0,0,12);tierTag.BackgroundTransparency=1;tierTag.Font=Enum.Font.GothamBold;tierTag.Text=isMaxGame and "MAX" or "PRO";tierTag.TextSize=8;tierTag.TextColor3=accentCol;tierTag.ZIndex=504

    -- Game icon top of main circle
    local icoLbl=Instance.new("TextLabel",main);icoLbl.AnchorPoint=Vector2.new(0.5,0);icoLbl.Position=UDim2.fromOffset(0,3);icoLbl.Size=UDim2.new(1,0,0,14);icoLbl.AnchorPoint=Vector2.new(0.5,0);icoLbl.BackgroundTransparency=1;icoLbl.Text=gameIcon;icoLbl.TextSize=11;icoLbl.ZIndex=504

    -- Invisible click button over everything
    local clickBtn=Instance.new("TextButton",con);clickBtn.Size=UDim2.fromOffset(SZ,SZ);clickBtn.BackgroundTransparency=1;clickBtn.Text="";clickBtn.ZIndex=510

    -- Pulse animation
    local alive=true
    task.spawn(function()
        while con.Parent and alive do
            TS:Create(outerGlow,TweenInfo.new(1.0,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{BackgroundTransparency=0.75}):Play()
            task.wait(1.0)
            if not(con.Parent and alive) then break end
            TS:Create(outerGlow,TweenInfo.new(1.0,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{BackgroundTransparency=0.2}):Play()
            task.wait(1.0)
        end
    end)

    -- Hover effect
    clickBtn.MouseEnter:Connect(function() TS:Create(main,TweenInfo.new(0.1),{BackgroundColor3=Color3.fromRGB(14,10,22)}):Play() end)
    clickBtn.MouseLeave:Connect(function() TS:Create(main,TweenInfo.new(0.1),{BackgroundColor3=Color3.fromRGB(7,5,12)}):Play() end)

    -- Pop-in entrance animation
    TS:Create(con,TweenInfo.new(0.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=UDim2.fromOffset(SZ,SZ)}):Play()

    -- Click restores window
    clickBtn.MouseButton1Click:Connect(function()
        alive=false
        TS:Create(con,TweenInfo.new(0.2,Enum.EasingStyle.Back,Enum.EasingDirection.In),{Size=UDim2.fromOffset(0,0)}):Play()
        task.wait(0.22)
        con:Destroy()
        onRestore()
    end)
    return con
end


