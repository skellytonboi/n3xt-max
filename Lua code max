-- Noclip helper
local function makeNoclipSystem(ST_ref,key)
    local touched={};local ls=0
    local function restore()
        for p in pairs(touched) do pcall(function() if p.Parent then p.CanCollide=true end end) end;touched={}
        local char=LP.Character;if char then for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then pcall(function() p.CanCollide=true end) end end end
    end
    reg(RunService.Heartbeat:Connect(function()
        if not ST_ref[key] then if next(touched) then restore() end;return end
        local n=tick();if n-ls<2.5 then return end;ls=n;restore()
        for _,p in ipairs(workspace:GetDescendants()) do
            if p:IsA("BasePart") and p.Anchored and p.Name~="Baseplate" and p.Size.Magnitude<500 and p.CanCollide then p.CanCollide=false;touched[p]=true end
        end
        local char=LP.Character;if char then for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") and p.CanCollide then p.CanCollide=false end end end
    end))
end

