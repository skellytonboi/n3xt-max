        godConns={};godHumanoid=hm
        pcall(function() hm:SetStateEnabled(Enum.HumanoidStateType.Dead,false) end)
        hm.MaxHealth=1e9;hm.Health=1e9
        table.insert(godConns,hm.HealthChanged:Connect(function(v) if v<hm.MaxHealth and v>0 then pcall(function() hm.Health=hm.MaxHealth end) end end))
        table.insert(godConns,hm.Died:Connect(function() pcall(function() hm.Health=hm.MaxHealth end) end))
    end
    local function setGod(on)
        if not on then
            for _,c in ipairs(godConns) do pcall(function() c:Disconnect() end) end;godConns={};godHumanoid=nil
            local char=LP.Character;local hm=char and char:FindFirstChildOfClass("Humanoid")
