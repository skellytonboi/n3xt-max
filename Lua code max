local function MkGrid(par,w,h,col,alpha)
    col=col or T.GRID;alpha=alpha or 0.86
    local g=Instance.new("Frame",par);g.Size=UDim2.fromOffset(w,h);g.BackgroundTransparency=1;g.ClipsDescendants=true;g.ZIndex=0
    for x=0,math.floor(w/28) do local f=Instance.new("Frame",g);f.Size=UDim2.new(0,1,1,0);f.Position=UDim2.fromOffset(x*28,0);f.BackgroundColor3=col;f.BackgroundTransparency=alpha;f.BorderSizePixel=0;f.ZIndex=0 end
    for y=0,math.floor(h/28) do local f=Instance.new("Frame",g);f.Size=UDim2.new(1,0,0,1);f.Position=UDim2.fromOffset(0,y*28);f.BackgroundColor3=col;f.BackgroundTransparency=alpha;f.BorderSizePixel=0;f.ZIndex=0 end
end

local function dumpWorkspace(folders)
    print("-------- N3XT DUMP --------")
    print("Place: "..game.PlaceId.."  JobId: "..game.JobId)
    for _,fname in ipairs(folders) do
        local f=workspace:FindFirstChild(fname)
        if f then
            local n=#f:GetChildren()
            print(string.format("[workspace.%s] %d children",fname,n))
            local shown=0
            for _,c in ipairs(f:GetChildren()) do if shown>=8 then break end;print("   "..c.ClassName.."  "..c.Name);shown=shown+1 end
        else print("[workspace."..fname.."] NOT FOUND") end
    end
    print("---------------------------")
    Notif("N3xt","Dump printed to F9 console")
end

