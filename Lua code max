    -- Main dark circle
    local main=Instance.new("Frame",outerGlow);main.AnchorPoint=Vector2.new(0.5,0.5);main.Position=UDim2.fromScale(0.5,0.5);main.Size=UDim2.fromOffset(SZ-8,SZ-8);main.BackgroundColor3=Color3.fromRGB(7,5,12);main.BorderSizePixel=0;main.ZIndex=502
